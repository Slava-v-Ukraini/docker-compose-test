    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Отримуємо рерайт від Gemini\nconst rawText = $input.item.json.content.parts[0].text;\nconst parsedData = JSON.parse(rawText);\n\n// 2. Звертаємося напряму до ноди Merge за HTML-кодом\nconst htmlContent = $('Merge').item.json.data || '';\nlet imageUrl = '';\n\nif (htmlContent) {\n    // Шукаємо метатег og:image\n    const match = htmlContent.match(/<meta[^>]*property=[\"']og:image[\"'][^>]*content=[\"']([^\"']+)[\"']/i) \n               || htmlContent.match(/<meta[^>]*content=[\"']([^\"']+)[\"'][^>]*property=[\"']og:image[\"']/i);\n    \n    if (match && match[1]) {\n        imageUrl = match[1];\n    }\n}\n\n// 3. Функція очищення тексту від сирих розривів рядків\nconst cleanString = (str) => {\n  if (!str) return '';\n  return str.replace(/\\n/g, \"\\\\n\").replace(/\\r/g, \"\\\\r\");\n};\n\n// 4. Формуємо контент. Використовуємо ОДИНАРНІ лапки всередині тегу <img>, щоб не ламати JSON\nlet finalContent = parsedData.ai_content;\nif (imageUrl) {\n    finalContent = `<img src='${imageUrl}' style='display:none;' />` + finalContent;\n}\n\nreturn {\n  json: {\n    title: parsedData.ai_title,\n    excerpt: cleanString(parsedData.ai_excerpt),\n    content: cleanString(finalContent)\n  }\n};"
      },
