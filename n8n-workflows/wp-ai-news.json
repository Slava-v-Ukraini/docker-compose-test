        "messages": {
          "values": [
            {
              "content": "=Зроби глибокий професійний рерайт новини українською мовою для технологічного порталу M-CORNER AI.\n\nОригінал для обробки:\nЗаголовок: {{ $json.title }}\nТекст: {{ $json.contentSnippet || $json.summary }}\n\nЗгенеруй три обов'язкові текстові поля:\n1. ai_title — новий клікабельний, але серйозний заголовок.\n2. ai_excerpt — короткий уривок (1-2 речення) для картки.\n3. ai_content — повний переписаний текст новини, розбитий на абзаци для зручного читання.\n\nТи працюєш у режимі JSON Mode, тому твоя відповідь повинна містити тільки об'єкт із цими трьома ключами. Не додавай жодних Markdown-обгорток, вступних слів чи символів екранування. Поверни чисті ключ-значення."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        624,
        -48
      ],
      "id": "c7f80666-7407-4328-8179-50a43f13fde3",
      "name": "Message a model",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
